rules_version = '2';

// Firebase Storage: de foto's van artiesten, crew en agenda.
service firebase.storage {
  match /b/{bucket}/o {

    // Iedereen mag de foto's zien (ze staan op de website). Uploaden mag
    // alleen een ingelogde beheerder, alleen afbeeldingen en maximaal 10 MB.
    match /{map}/{bestand} {
      allow read: if true;
      allow write: if request.auth != null
                   && map in ['agenda-images', 'artiesten-images', 'crew-images']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // weghalen mag een ingelogde beheerder ook
      allow delete: if request.auth != null;
    }

    // Al het andere staat standaard dicht.
    match /{allePaden=**} {
      allow read, write: if false;
    }
  }
}
