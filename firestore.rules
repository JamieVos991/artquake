rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reserveringen: het publieke boekingsformulier (/reserveren) mag zonder
    // login een nieuwe reservering aanmaken én moet bestaande reserveringen
    // kunnen lezen (om te bepalen welke tijden al bezet zijn, zodat maar
    // 1 persoon per tijdslot kan boeken). Wijzigen/verwijderen mag alleen
    // door ingelogde beheerders (dashboard).
    match /reserveringen/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
                        ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd']
                      )
                    && request.resource.data.studio is string
                    && request.resource.data.naam is string
                    && request.resource.data.email is string
                    && request.resource.data.datum is string
                    && request.resource.data.starttijd is string
                    && request.resource.data.eindtijd is string;
      allow update: if request.auth != null;
      // Zelf annuleren (vanaf het bevestigingsscherm, direct na het boeken)
      // mag ook zonder login, maar alleen in de eerste 5 minuten na
      // aanmaken — zo kan iemand een typefout meteen herstellen, zonder dat
      // reserveringen van anderen op afstand te verwijderen zijn.
      allow delete: if request.auth != null
                    || (resource.data.aangemaaktOp is timestamp
                        && request.time < resource.data.aangemaaktOp + duration.value(5, 'm'));
    }

    // Reserveringen in afwachting van e-mailverificatie: bevat een 6-cijferige
    // code die naar het opgegeven e-mailadres is gestuurd. "get" (opvragen via
    // het exacte, willekeurige document-ID dat de eigen browser net kreeg) mag
    // altijd; "list" (het hele overzicht doorzoeken) mag nooit — zo kan alleen
    // wie de mail met de code heeft ontvangen bij die code, ook al is er geen
    // login. Documenten verlopen vanzelf (client checkt aangemaaktOp) en zijn
    // door de maker zelf 20 minuten lang op te ruimen.
    match /reserveringen_pending/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(
                        ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd', 'code', 'aangemaaktOp']
                      )
                    && request.resource.data.studio is string
                    && request.resource.data.naam is string
                    && request.resource.data.email is string
                    && request.resource.data.datum is string
                    && request.resource.data.starttijd is string
                    && request.resource.data.eindtijd is string
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    || (resource.data.aangemaaktOp is timestamp
                        && request.time < resource.data.aangemaaktOp + duration.value(20, 'm'));
    }

    // Agenda & artiesten: publiek zichtbaar op de website, alleen
    // ingelogde beheerders mogen ze aanmaken/wijzigen/verwijderen.
    match /agenda/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artiesten/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Al het andere staat standaard dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
