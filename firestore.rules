rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reserveringen: alleen ingelogde gebruikers mogen reserveren. Het
    // boekingsformulier (/reserveren) zit achter de login, dus lezen (om te
    // zien welke tijden al bezet zijn), aanmaken, wijzigen en verwijderen
    // mag alleen met een account.
    match /reserveringen/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(
                        ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd']
                      )
                    && request.resource.data.studio is string
                    && request.resource.data.naam is string
                    && request.resource.data.email is string
                    && request.resource.data.datum is string
                    && request.resource.data.starttijd is string
                    && request.resource.data.eindtijd is string;
      allow update, delete: if request.auth != null;
    }

    // Reserveringen in afwachting van e-mailverificatie: bevat een 6-cijferige
    // code die naar het opgegeven e-mailadres is gestuurd. Ook alleen voor
    // ingelogde gebruikers. "list" (het hele overzicht doorzoeken) mag nooit,
    // zodat codes van anderen niet op te vragen zijn.
    match /reserveringen_pending/{id} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(
                        ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd', 'code', 'aangemaaktOp']
                      )
                    && request.resource.data.studio is string
                    && request.resource.data.naam is string
                    && request.resource.data.email is string
                    && request.resource.data.datum is string
                    && request.resource.data.starttijd is string
                    && request.resource.data.eindtijd is string
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6;
      allow update, delete: if request.auth != null;
    }

    // Agenda & artiesten: publiek zichtbaar op de website, alleen
    // ingelogde beheerders mogen ze aanmaken/wijzigen/verwijderen.
    match /agenda/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artiesten/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Al het andere staat standaard dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
